# chatbot.conf — external paths and environment settings
# Copy this file to chatbot.conf and fill in your values.

# ChromaDB location (where ingested documents are stored)
# $PROJECT_DIR is set by start_unified.sh before this file is sourced; replace
# with an absolute path if your chroma_db lives outside the repo
CHROMA_PERSIST_DIR="$PROJECT_DIR/rag-service/ingestion/chroma_db"

# ChromaDB collection name
CHROMA_COLLECTION="nougat_merged"

# Sentence transformer model for embeddings
EMBED_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Conda environment name (used by RAG service and ingestion pipeline)
CONDA_ENV="spear"
